<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- ── Header ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/colorSurface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_restaurant"
            app:tint="@color/colorNutricion"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nutrición"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnSurface"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- PROGRESO DEL DÍA -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorSurfaceVariant"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorNutricionLight"
                app:strokeWidth="1dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resumen del día"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorNutricion"
                        android:layout_marginBottom="14dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Calorías" android:textSize="12sp" android:textColor="@color/colorTextSecondary" android:layout_marginBottom="4dp"/>
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/pbCalorias"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:trackColor="@color/colorDivider"
                        app:indicatorColor="#EF6363"
                        app:trackCornerRadius="4dp"
                        android:max="2500"
                        android:progress="0"/>
                    <TextView
                        android:id="@+id/tvProgresoCalorias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 2500 kcal"
                        android:textSize="12sp"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Proteínas" android:textSize="12sp" android:textColor="@color/colorTextSecondary" android:layout_marginBottom="4dp"/>
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/pbProteinas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:trackColor="@color/colorDivider"
                        app:indicatorColor="@color/colorEntrenamiento"
                        app:trackCornerRadius="4dp"
                        android:max="180"
                        android:progress="0"/>
                    <TextView
                        android:id="@+id/tvProgresoProteinas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 180 g P"
                        android:textSize="12sp"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Carbohidratos" android:textSize="12sp" android:textColor="@color/colorTextSecondary" android:layout_marginBottom="4dp"/>
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/pbCarbs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:trackColor="@color/colorDivider"
                        app:indicatorColor="@color/colorHistorial"
                        app:trackCornerRadius="4dp"
                        android:max="280"
                        android:progress="0"/>
                    <TextView
                        android:id="@+id/tvProgresoCarbs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 280 g C"
                        android:textSize="12sp"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Grasas" android:textSize="12sp" android:textColor="@color/colorTextSecondary" android:layout_marginBottom="4dp"/>
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/pbGrasas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:trackColor="@color/colorDivider"
                        app:indicatorColor="@color/colorIA"
                        app:trackCornerRadius="4dp"
                        android:max="70"
                        android:progress="0"/>
                    <TextView
                        android:id="@+id/tvProgresoGrasas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 70 g G"
                        android:textSize="12sp"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- FORMULARIO DE INGESTA -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorSurfaceVariant"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorNutricionLight"
                app:strokeWidth="1dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Registrar ingesta"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorNutricion"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/tvAlimentoSeleccionado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ningún alimento seleccionado"
                        android:textSize="14sp"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:layout_marginBottom="10dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnElegirAlimento"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:text="ELEGIR ALIMENTO"
                        app:backgroundTint="@color/colorNutricion"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_search"
                        app:iconSize="18dp"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Cantidad (gramos)"
                        style="@style/Widget.DiaAIA.TextInputLayout"
                        android:layout_marginBottom="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etGramos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textColor="@color/colorOnSurface"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGuardarIngesta"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="GUARDAR INGESTA"
                        app:backgroundTint="@color/colorNutricionLight"
                        app:strokeColor="@color/colorNutricion"
                        app:strokeWidth="1dp"
                        android:textColor="@color/colorNutricion"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_check"
                        app:iconSize="18dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingestas de hoy"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurface"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvVacioIngestas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aún no has registrado nada hoy."
                android:gravity="center"
                android:textColor="@color/colorTextHint"
                android:padding="12dp"
                android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvIngestasHoy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/colorSurface">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIrIANutricion"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="IA"
            app:backgroundTint="@color/colorIALight"
            app:strokeColor="@color/colorIA"
            app:strokeWidth="1dp"
            android:textColor="@color/colorIA"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_auto_awesome"
            app:iconSize="18dp"
            android:layout_marginEnd="6dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverNutricion"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Volver"
            app:backgroundTint="@color/colorSurfaceElevated"
            android:textColor="@color/colorTextSecondary"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_arrow_back"
            app:iconSize="18dp"/>
    </LinearLayout>
</LinearLayout>
