<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/colorSurfaceVariant"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/colorEntrenamientoLight"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Nombre + músculo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreEjRutina"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ejercicio"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurface"/>

            <TextView
                android:id="@+id/tvMusculoEjRutina"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Músculo"
                android:textSize="12sp"
                android:textColor="@color/colorEntrenamiento"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Series -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Series"
                android:textSize="10sp"
                android:textColor="@color/colorTextSecondary"
                android:gravity="center"/>

            <EditText
                android:id="@+id/etSeriesPlaneadas"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:inputType="number"
                android:text="3"
                android:textSize="14sp"
                android:textColor="@color/colorOnSurface"
                android:textAlignment="center"
                android:gravity="center"
                android:background="@color/colorSurfaceElevated"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"/>
        </LinearLayout>

        <!-- Reps -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reps"
                android:textSize="10sp"
                android:textColor="@color/colorTextSecondary"
                android:gravity="center"/>

            <EditText
                android:id="@+id/etRepsPlaneadas"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:inputType="number"
                android:text="10"
                android:textSize="14sp"
                android:textColor="@color/colorOnSurface"
                android:textAlignment="center"
                android:gravity="center"
                android:background="@color/colorSurfaceElevated"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"/>
        </LinearLayout>

        <!-- Botón quitar -->
        <ImageButton
            android:id="@+id/btnQuitarEjRutina"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/colorError"
            android:contentDescription="Quitar ejercicio"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
