<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- ── Header ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/colorSurface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_fitness_center"
            app:tint="@color/colorEntrenamiento"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/tvTituloSesion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sesión"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnSurface"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/llEjerciciosSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/colorSurface">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnadirEjSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="AÑADIR EJERCICIO"
            app:backgroundTint="@color/colorNutricionLight"
            app:strokeColor="@color/colorNutricion"
            app:strokeWidth="1dp"
            android:textColor="@color/colorNutricion"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_add"
            app:iconSize="18dp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinalizarSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="FINALIZAR SESIÓN"
            android:textStyle="bold"
            app:backgroundTint="@color/colorEntrenamiento"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_check"
            app:iconSize="20dp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Cancelar sesión"
            app:backgroundTint="@color/colorErrorContainer"
            android:textColor="@color/colorError"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_close"
            app:iconSize="16dp"/>
    </LinearLayout>
</LinearLayout>
