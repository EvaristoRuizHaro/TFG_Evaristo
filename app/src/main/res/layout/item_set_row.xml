<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:layout_marginBottom="4dp">

    <TextView
        android:id="@+id/tvSetLabel"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:text="Set 1"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/colorTextSecondary"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="kg"
        style="@style/Widget.DiaAIA.TextInputLayout"
        android:layout_marginEnd="6dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPesoSet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textAlignment="center"
            android:textColor="@color/colorOnSurface"
            android:textSize="14sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="reps"
        style="@style/Widget.DiaAIA.TextInputLayout"
        android:layout_marginEnd="6dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRepsSet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textAlignment="center"
            android:textColor="@color/colorOnSurface"
            android:textSize="14sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <ImageButton
        android:id="@+id/btnGuardarSet"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_check"
        android:background="@drawable/bg_icon_circle"
        android:backgroundTint="@color/colorEntrenamientoLight"
        app:tint="@color/colorEntrenamiento"
        android:padding="8dp"
        android:contentDescription="Guardar set"/>
</LinearLayout>
