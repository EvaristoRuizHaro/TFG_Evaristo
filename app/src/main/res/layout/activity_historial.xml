<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- ── Header ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/colorSurface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_history"
            app:tint="@color/colorHistorial"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mi Actividad"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnSurface"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvVacioHistorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aún no hay actividad registrada."
        android:gravity="center"
        android:textColor="@color/colorTextHint"
        android:padding="24dp"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistorial"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVolverHistorial"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="VOLVER AL MENÚ"
        android:layout_margin="16dp"
        app:backgroundTint="@color/colorSurfaceElevated"
        android:textColor="@color/colorOnSurface"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_arrow_back"
        app:iconSize="18dp"/>
</LinearLayout>
